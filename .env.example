# Copy to .env and fill in real values. Never commit the real .env file.

# development | production. In production JWT_SECRET is mandatory and demo users are never seeded.
ENVIRONMENT=development

# --- Database ---
# Leave empty to use a local SQLite file at data/app.db (zero setup).
# PostgreSQL example (written but not yet tested against a live Postgres):
# DATABASE_URL=postgresql://cve_user:change-me@localhost:5432/cve_intelligence
DATABASE_URL=

# --- Auth ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty in development, an ephemeral secret is generated (everyone is signed out on restart).
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# Optional overrides for the development-only demo accounts
# DEMO_ADMIN_PASSWORD=
# DEMO_ANALYST_PASSWORD=
# DEMO_VIEWER_PASSWORD=

# --- Local AI services ---
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=llama3.1

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Voice input ---
# Largest voice recording the backend will accept, in bytes (default 10 MB)
# MAX_AUDIO_BYTES=10485760

# --- Voice assistant speed/accuracy ---
# Speech model: base (fast, weak on Tamil/Hindi) | small (default) | medium (best, slow on CPU)
# WHISPER_MODEL=small
# WHISPER_BEAM_SIZE=1
# Translation beam search: 1 = fastest, 4-5 = best quality
# TRANSLATION_BEAMS=2
# Load models in the background when the server starts (true by default)
# WARMUP_ON_START=true
# Keep the language model in memory between questions, and cap the answer length
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_NUM_PREDICT=220
# OLLAMA_TIMEOUT=90
